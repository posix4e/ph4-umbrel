#!/bin/sh
# umbreld runs this as root before `docker compose up`. i2pd and the mirror run
# as uid 1000 and must own their bind mounts; umbreld strips .gitkeep files, so
# the directories may not exist yet. The census mirror tunnel is switched on
# only once its destination key is in place: without the key, i2pd would make
# a new one under that name and the mirror would come up at the wrong address.
cd "$(dirname "$0")/.." || exit 0
mkdir -p data/tor data/i2p data/i2pd/tunnels.d data/census
key=data/i2pd/winnow-census-mirror.dat
tunnel=data/i2pd/tunnels.d/winnow-census-mirror.conf
if [ -f "$key" ]; then
  cp tunnels/winnow-census-mirror.conf "$tunnel"
  chmod 640 "$key"
else
  rm -f "$tunnel"
fi
chown -R 1000:1000 data/i2pd data/census
